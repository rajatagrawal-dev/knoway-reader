import pkg from "pdf-lib";
const { PDFDocument, StandardFonts, rgb } = pkg;
import { writeFile } from "fs/promises";

const doc = await PDFDocument.create();
const font = await doc.embedFont(StandardFonts.Helvetica);
for (let i = 1; i <= 30; i++) {
  const page = doc.addPage([600, 800]);
  page.drawText(`Test PDF - Page ${i}`, { x: 50, y: 750, size: 28, font, color: rgb(0, 0, 0) });
  page.drawText(
    `This is a filler paragraph on page ${i}. `.repeat(40),
    { x: 50, y: 400, size: 12, font, maxWidth: 500, lineHeight: 16 },
  );
}
const bytes = await doc.save();
await writeFile("/private/tmp/claude-501/-Users-rajat-Projects-LifelongLearning/b9a06dbb-dc38-4bbc-9912-0fc97b436f53/scratchpad/test.pdf", bytes);
console.log("done");
