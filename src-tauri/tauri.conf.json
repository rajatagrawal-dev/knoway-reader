{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Knowbel Reader",
  "version": "0.1.0",
  "identifier": "com.knowbelreader.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && npm run build:server"
  },
  "app": {
    "windows": [
      {
        "title": "Knowbel Reader",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "maximized": true,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/*"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
