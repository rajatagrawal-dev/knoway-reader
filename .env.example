# Deep Dive can run its two roles — "dive" (the main explain/chat panel) and
# "quick" (one-tap glossary answers) — through different providers/models.
# With nothing set below, every role uses Meta's Muse Spark API, which
# needs MUSE_SPARK_API_KEY.
#
# Supported DIVE_PROVIDER / QUICK_PROVIDER values:
#   muse-spark     - Meta's Muse Spark, needs MUSE_SPARK_API_KEY (default)
#   anthropic      - Claude API, needs ANTHROPIC_API_KEY
#   openai         - OpenAI API, needs OPENAI_API_KEY
#   google         - Gemini API, needs GOOGLE_API_KEY
#
# Optional overrides:
# PORT=4300

# --- Dive (main panel) ---
# DIVE_PROVIDER=muse-spark
# DIVE_MODEL=muse-spark-1.3-contributor

# --- Quick meaning (one-tap glossary) ---
# QUICK_PROVIDER=muse-spark
# QUICK_MODEL=muse-spark-1.3-contributor

# --- Glossary ("Add to glossary" definitions) ---
# Runs at low reasoning effort — definitions are shown as the reader waits.
# GLOSSARY_PROVIDER=muse-spark
# GLOSSARY_MODEL=muse-spark-1.3-contributor

# Glossary entries also show a dictionary/encyclopedia meaning, looked up
# on Wiktionary and Wikipedia (free, no key). Wikimedia allows 10 requests
# a minute to clients that give no contact and 200 to ones that do — set
# this to an email address or a URL where you can be reached.
# REFERENCE_CONTACT=

# --- API keys (only needed for the providers you actually select above) ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# MUSE_SPARK_API_KEY=
