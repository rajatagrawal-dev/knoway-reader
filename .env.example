# Deep Dive can run its two roles — "dive" (the main explain/chat panel) and
# "quick" (one-tap glossary answers) — through different providers/models.
# With nothing set below, both default to the local `claude` CLI (Claude
# Code), which rides your Claude subscription auth and needs no API key.
#
# Supported DIVE_PROVIDER / QUICK_PROVIDER values:
#   anthropic-cli  - local `claude` CLI, subscription auth (default)
#   anthropic      - Claude API, needs ANTHROPIC_API_KEY
#   openai         - OpenAI API, needs OPENAI_API_KEY
#   google         - Gemini API, needs GOOGLE_API_KEY
#   muse-spark     - Meta's Muse Spark, needs MUSE_SPARK_API_KEY
#
# Optional overrides:
# PORT=4300
# CLAUDE_BIN=claude

# --- Dive (main panel) ---
# DIVE_PROVIDER=anthropic-cli
# DIVE_MODEL=claude-sonnet-5

# --- Quick meaning (one-tap glossary) ---
# QUICK_PROVIDER=anthropic-cli
# QUICK_MODEL=claude-haiku-4-5-20251001

# --- Glossary ("Add to glossary" definitions) ---
# Unlike the roles above, this defaults to the Muse Spark API (low reasoning
# effort) rather than the CLI — definitions are shown as the reader waits,
# and the CLI's per-request startup is too slow for that.
# GLOSSARY_PROVIDER=muse-spark
# GLOSSARY_MODEL=muse-spark-1.3-contributor

# --- API keys (only needed for the providers you actually select above) ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# MUSE_SPARK_API_KEY=
