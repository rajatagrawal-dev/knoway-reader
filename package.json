{
  "name": "knowbelreader",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n vite,server -c blue,green \"vite\" \"node server/index.js\"",
    "build": "tsc -b && vite build",
    "build:server": "node scripts/build-server.mjs",
    "start": "NODE_ENV=production node server/index.js",
    "server": "node server/index.js",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node --test server/*.test.js server/providers/*.test.js src/glossary/*.test.ts src/storage/*.test.ts src/text/*.test.ts src/navigation/*.test.ts src/grounding/*.test.ts src/library/*.test.ts src/xref/*.test.ts src/notation/*.test.ts src/deepdive/*.test.ts src/figures/*.test.ts src/epub/*.test.ts src/web/*.test.ts",
    "tauri": "tauri",
    "postinstall": "patch-package",
    "eval:grounding": "node scripts/eval-grounding.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/literata": "^0.4.3",
    "@mozilla/readability": "^0.6.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-fs": "^2.6.0",
    "@tauri-apps/plugin-opener": "^2.6.0",
    "dejavu-fonts-ttf": "^2.37.3",
    "express": "^5.2.1",
    "fflate": "^0.8.3",
    "html2canvas-pro": "^2.5.2",
    "katex": "^0.18.4",
    "lucide-react": "^0.559.0",
    "mermaid": "^12.0.0",
    "openai": "^7.15.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-pdf-highlighter-plus": "^1.3.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "linkedom": "^0.18.13",
    "oxlint": "^1.75.0",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
